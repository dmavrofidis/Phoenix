<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Phoenix exports are explicit and user-controlled; health profiles are
         never placed into Android cloud or device-transfer backups. -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
