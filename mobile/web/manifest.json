{
    "id": "./",
    "name": "Phoenix — Local Fitness OS",
    "short_name": "Phoenix",
    "start_url": "./?pwa=1",
    "scope": "./",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone"],
    "background_color": "#090D0F",
    "theme_color": "#090D0F",
    "description": "Private, offline-first training, nutrition, recovery and calisthenics companion.",
    "orientation": "portrait-primary",
    "categories": ["fitness", "health", "lifestyle"],
    "lang": "el",
    "dir": "ltr",
    "prefer_related_applications": false,
    "launch_handler": {"client_mode": "navigate-existing"},
    "share_target": {
        "action": "./?share-target=1",
        "method": "GET",
        "params": {"title": "title", "text": "text", "url": "url"}
    },
    "file_handlers": [
        {
            "action": "./?file-handler=1",
            "accept": {
                "application/json": [".json"],
                "text/csv": [".csv"],
                "application/gpx+xml": [".gpx"],
                "application/octet-stream": [".phx", ".phxsync"]
            }
        }
    ],
    "shortcuts": [
        {
            "name": "Phoenix Today",
            "short_name": "Today",
            "url": "./?shortcut=today"
        },
        {
            "name": "Quick workout",
            "short_name": "Workout",
            "url": "./?shortcut=workout"
        }
    ],
    "icons": [
        {
            "src": "icons/Icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "icons/Icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "icons/Icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/Icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
